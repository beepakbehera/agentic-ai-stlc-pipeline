# =============================================================================
# Agentic AI STLC Pipeline - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
# =============================================================================

# ===== NVIDIA Nemotron 3 Ultra 550B =====
# Get API key from: https://build.nvidia.com/explore/discover
NEMOTRON_API_KEY=your-nemotron-api-key-here
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-ultra
NEMOTRON_TEMPERATURE=0.1
NEMOTRON_MAX_TOKENS=8192

# ===== Jira Cloud REST API v3 =====
# Jira Cloud instance URL (e.g., https://your-domain.atlassian.net)
JIRA_BASE_URL=https://your-domain.atlassian.net
# Jira account email
JIRA_EMAIL=your-email@domain.com
# Jira API token (create at: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your-jira-api-token-here
# Jira project key (e.g., PROJ, TEST, QA)
JIRA_PROJECT_KEY=PROJ
# Issue type for defects (Bug, Task, Story, etc.)
JIRA_ISSUE_TYPE=Bug

# ===== GitHub Actions =====
# GitHub Personal Access Token with repo and workflow scopes
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your-github-token-here
GITHUB_REPO_OWNER=beepakbehera
GITHUB_REPO_NAME=agentic-ai-stlc-pipeline
GITHUB_WORKFLOW_ID=agentic_tests.yml

# ===== Vector Database / RAG =====
# Local ChromaDB path
VECTOR_DB_PATH=./data/vector_db
# Embedding model for document retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5

# ===== MCP Selector Self-Healing =====
# MCP server URL for selector healing
MCP_SERVER_URL=http://localhost:3000
MCP_TIMEOUT=30

# ===== Pipeline Execution =====
PIPELINE_TIMEOUT=3600
MAX_RETRIES=3
LOG_LEVEL=INFO

# ===== Optional: LangSmith Tracing =====
# Get API key from: https://smith.langchain.com/
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-ai-stlc-pipeline

# ===== Application Under Test =====
# Base URL for the application under test
BASE_URL=https://staging.example.com
# API URL for the application
API_URL=https://api-staging.example.com
# Browser for testing (chromium, firefox, webkit)
BROWSER=chromium
# Run headless
HEADLESS=true

# ===== Environment =====
ENVIRONMENT=staging